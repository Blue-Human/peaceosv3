{
  "name": "peaceos-verify",
  "private": true,
  "version": "0.1.0",
  "description": "PeaceOS Verify — VEP format and offline verification tooling (Phase 1).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @peaceos/spec --filter @peaceos/core --filter @peaceos/cli --filter @peaceos/examples --filter @peaceos/web --if-present run build",
    "deploy": "pnpm --dir web exec wrangler deploy --no-autoconfig",
    "deploy:dry-run": "pnpm --dir web exec wrangler deploy --no-autoconfig --dry-run",
    "test": "pnpm --filter @peaceos/spec --filter @peaceos/core --filter @peaceos/cli --filter @peaceos/examples --filter @peaceos/web --if-present run test",
    "typecheck": "pnpm --filter @peaceos/spec --filter @peaceos/core --filter @peaceos/cli --filter @peaceos/examples --filter @peaceos/web --if-present run typecheck",
    "versions:upload": "pnpm --dir web exec wrangler versions upload",
    "versions:upload:dry-run": "pnpm --dir web exec wrangler versions upload --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
